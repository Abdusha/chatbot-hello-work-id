{
  "version": 2,
  "framework": null,
  "builds": [
    {
      "src": "server.js",
      "use": "@vercel/node"
    }
  ],
  "routes": [
    {
      "src": "/api/(.*)",
      "dest": "server.js"
    },
    {
      "src": "/(.*\\.(html|css|js|svg|png|jpg|ico))",
      "dest": "public/$1"
    },
    {
      "src": "/",
      "dest": "public/chat.html"
    }
  ]
}
